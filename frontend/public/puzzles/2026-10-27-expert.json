k","kind":"nominal","label":"Tank","values":[{"glyph":"","id":"mangrove","label":"Mangrove","phrase":"tends the Mangrove","refPhrase":"one at the Mangrove"},{"glyph":"","id":"reef","label":"Coral Reef","phrase":"tends the Coral Reef","refPhrase":"one at the Coral Reef"},{"glyph":"","id":"tidepool","label":"Tide Pool","phrase":"tends the Tide Pool","refPhrase":"one at the Tide Pool"},{"glyph":"","id":"openocean","label":"Open Ocean","phrase":"tends the Open Ocean","refPhrase":"one at the Open Ocean"},{"glyph":"","id":"abyss","label":"Deep Abyss","phrase":"tends the Deep Abyss","refPhrase":"one at the Deep Abyss"},{"glyph":"","id":"kelp","label":"Kelp Forest","phrase":"tends the Kelp Forest","refPhrase":"one at the Kelp Forest"}]},{"anchor":false,"cardinality":"bijective","glyphPack":"food","id":"treat","kind":"nominal","label":"Treat","values":[{"glyph":"food.popsicle","id":"popsicle","label":"Popsicle","phrase":"handed out the popsicles","refPhrase":"popsicle giver"},{"glyph":"food.cookie","id":"cookie","label":"Cookies","phrase":"handed out the cookies","refPhrase":"cookie giver"},{"glyph":"food.chocolate","id":"chocolate","label":"Chocolate","phrase":"handed out the chocolate","refPhrase":"chocolate giver"},{"glyph":"food.cupcake","id":"cupcake","label":"Cupcake","phrase":"handed out the cupcakes","refPhrase":"cupcake giver"},{"glyph":"food.icecream","id":"icecream","label":"Ice cream","phrase":"handed out the ice cream","refPhrase":"ice-cream giver"},{"glyph":"food.donut","id":"donut","label":"Donut","phrase":"handed out the donuts","refPhrase":"donut giver"}]}],"n":5},"constraints":[{"clueText":"It was not the one with the shrimp who tends the Kelp Forest.","id":"c1","operands":[{"cat":"creature","value":"shrimp"},{"cat":"tank","value":"kelp"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"Rosa's feeding came 1 rounds after Layla's.","id":"c2","operands":[{"cat":"keeper","value":"rosa"},{"cat":"keeper","value":"layla"}],"params":{"delta":1,"dir":"greater","numericCat":"feeding"},"renderHint":"numDiff","type":"numDiff"},{"clueText":"For Gus it came to Fish or Crab - only one, in the end.","id":"c3","operands":[{"cat":"keeper","value":"gus"},{"cat":"creature","value":"fish"},{"cat":"creature","value":"crab"}],"params":{},"renderHint":"oneOf","type":"oneOf"},{"clueText":"The one who handed out the cookies was not 1st.","id":"c4","operands":[{"cat":"feeding","value":"feed1"},{"cat":"treat","value":"cookie"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"The one who tends the Coral Reef was Gus.","id":"c5","operands":[{"cat":"keeper","value":"gus"},{"cat":"tank","value":"reef"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"Gus's feeding came 4 rounds after Layla's.","id":"c6","operands":[{"cat":"keeper","value":"gus"},{"cat":"keeper","value":"layla"}],"params":{"delta":4,"dir":"greater","numericCat":"feeding"},"renderHint":"numDiff","type":"numDiff"},{"clueText":"It was not 4th who handed out the donuts.","id":"c7","operands":[{"cat":"feeding","value":"feed4"},{"cat":"treat","value":"donut"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"It was the one with the crab who tends the Mangrove.","id":"c8","operands":[{"cat":"creature","value":"crab"},{"cat":"tank","value":"mangrove"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"Of Mina and Tom, one handed out the cupcakes and the other handed out the cookies.","id":"c9","operands":[{"cat":"keeper","value":"mina"},{"cat":"keeper","value":"tom"},{"cat":"treat","value":"cupcake"},{"cat":"treat","value":"cookie"}],"params":{},"renderHint":"oneEachOf","type":"oneEachOf"},{"clueText":"Layla fed no earlier than round 2.","id":"c10","operands":[{"cat":"keeper","value":"layla"}],"params":{"bound":2,"dir":"atleast","numericCat":"feeding"},"renderHint":"threshold","type":"threshold"},{"clueText":"The one who handed out the popsicles was the one at the Tide Pool.","id":"c11","operands":[{"cat":"tank","value":"tidepool"},{"cat":"treat","value":"popsicle"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"1st was not the one who tends the Deep Abyss.","id":"c12","operands":[{"cat":"feeding","value":"feed1"},{"cat":"tank","value":"abyss"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"Kai was down to Deep Abyss or Tide Pool, and took just one.","id":"c13","operands":[{"cat":"keeper","value":"kai"},{"cat":"tank","value":"abyss"},{"cat":"tank","value":"tidepool"}],"params":{},"renderHint":"oneOf","type":"oneOf"},{"clueText":"The one who handed out the cupcakes was not the one with the crab.","id":"c14","operands":[{"cat":"creature","value":"crab"},{"cat":"treat","value":"cupcake"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"It was the one with the turtle who tends the Deep Abyss.","id":"c15","operands":[{"cat":"creature","value":"turtle"},{"cat":"tank","value":"abyss"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"Tom was down to Shrimp or Shark, and took just one.","id":"c16","operands":[{"cat":"keeper","value":"tom"},{"cat":"creature","value":"shrimp"},{"cat":"creature","value":"shark"}],"params":{},"renderHint":"oneOf","type":"oneOf"},{"clueText":"Of Gus and Kai, one handed out the donuts and the other handed out the chocolate.","id":"c17","operands":[{"cat":"keeper","value":"gus"},{"cat":"keeper","value":"kai"},{"cat":"treat","value":"donut"},{"cat":"treat","value":"chocolate"}],"params":{},"renderHint":"oneEachOf","type":"oneEachOf"},{"clueText":"Tom fed 3 rounds later than Layla.","id":"c18","operands":[{"cat":"keeper","value":"tom"},{"cat":"keeper","value":"layla"}],"params":{"delta":3,"dir":"greater","numericCat":"feeding"},"renderHint":"numDiff","type":"numDiff"},{"clueText":"The one who took the 3rd feeding was the one with the shark.","id":"c19","operands":[{"cat":"creature","value":"shark"},{"cat":"feeding","value":"feed3"}],"params":{},"renderHint":"eq","type":"eq"}],"entities":["e0","e1","e2","e3","e4","e5"],"hintTrace":[{"forces":{"cat":"creature","entity":"e4","value":"turtle"},"fromClues":["c15"]},{"forces":{"cat":"creature","entity":"e1","value":"shark"},"fromClues":["c16","c19"]},{"forces":{"cat":"creature","entity":"e2","value":"crab"},"fromClues":["c3","c8","c14"]},{"forces":{"cat":"creature","entity":"e5","value":"shrimp"},"fromClues":["c1","c16"]},{"forces":{"cat":"creature","entity":"e3","value":"penguin"},"fromClues":["c1"]},{"forces":{"cat":"creature","entity":"e0","value":"fish"},"fromClues":["c3"]},{"forces":{"cat":"feeding","entity":"e2","value":"feed2"},"fromClues":["c1"]},{"forces":{"cat":"feeding","entity":"e1","value":"feed3"},"fromClues":["c19"]},{"forces":{"cat":"feeding","entity":"e5","value":"feed5"},"fromClues":["c1"]},{"forces":{"cat":"feeding","entity":"e0","value":"feed6"},"fromClues":["c1"]},{"forces":{"cat":"feeding","entity":"e3","value":"feed1"},"fromClues":["c4","c12"]},{"forces":{"cat":"feeding","entity":"e4","value":"feed4"},"fromClues":["c7"]},{"forces":{"cat":"tank","entity":"e2","value":"mangrove"},"fromClues":["c8"]},{"forces":{"cat":"tank","entity":"e0","value":"reef"},"fromClues":["c5"]},{"forces":{"cat":"tank","entity":"e1","value":"tidepool"},"fromClues":["c11","c13"]},{"forces":{"cat":"tank","entity":"e5","value":"openocean"},"fromClues":["c1"]},{"forces":{"cat":"tank","entity":"e4","value":"abyss"},"fromClues":["c12","c13","c15"]},{"forces":{"cat":"tank","entity":"e3","value":"kelp"},"fromClues":["c1"]},{"forces":{"cat":"treat","entity":"e1","value":"popsicle"},"fromClues":["c11"]},{"forces":{"cat":"treat","entity":"e5","value":"cookie"},"fromClues":["c4","c9"]},{"forces":{"cat":"treat","entity":"e4","value":"chocolate"},"fromClues":["c17"]},{"forces":{"cat":"treat","entity":"e3","value":"cupcake"},"fromClues":["c9","c14"]},{"forces":{"cat":"treat","entity":"e2","value":"icecream"},"fromClues":["c1"]},{"forces":{"cat":"treat","entity":"e0","value":"donut"},"fromClues":["c7","c17"]}],"puzzleId":"2026-10-27","scenarioId":"aquarium-night","schemaVersion":2,"shapeId":"grid","solution":{"e0":{"creature":"fish","feeding":"feed6","keeper":"gus","tank":"reef","treat":"donut"},"e1":{"creature":"shark","feeding":"feed3","keeper":"rosa","tank":"tidepool","treat":"popsicle"},"e2":{"creature":"crab","feeding":"feed2","keeper":"layla","tank":"mangrove","treat":"icecream"},"e3":{"creature":"penguin","feeding":"feed1","keeper":"mina","tank":"kelp","treat":"cupcake"},"e4":{"creature":"turtle","feeding":"feed4","keeper":"kai","tank":"abyss","treat":"chocolate"},"e5":{"creature":"shrimp","feeding":"feed5","keeper":"tom","tank":"openocean","treat":"cookie"}},"story":"The aquarium settles into its after-hours calm, lit only by the blue glow of the great windows, as six keepers make their final rounds while Ms. Ferreira checks the log after a splash from the pool left the schedule in a muddle. Each keeper has a different creature, feeding, tank and treat. Using the clues, match every keeper to their creature, feeding, tank and treat.","subjectNoun":"keeper","templateRev":1,"tier":"expert","variant":1}
