e","value":"fugue"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"For Elif it was Dress shirt or Gown - not both.","id":"c4","operands":[{"cat":"musician","value":"elif"},{"cat":"outfit","value":"manshirt"},{"cat":"outfit","value":"womandress"}],"params":{},"renderHint":"oneOf","type":"oneOf"},{"clueText":"Idris took chair 2.","id":"c5","operands":[{"cat":"musician","value":"idris"},{"cat":"seat","value":"chair2"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"Of Greta and Idris, one tuned the oboe and the other tuned the flute.","id":"c6","operands":[{"cat":"musician","value":"greta"},{"cat":"musician","value":"idris"},{"cat":"instrument","value":"oboe"},{"cat":"instrument","value":"flute"}],"params":{},"renderHint":"oneEachOf","type":"oneEachOf"},{"clueText":"The one who wore the dress shirt was not the anthem player.","id":"c7","operands":[{"cat":"piece","value":"anthem"},{"cat":"outfit","value":"manshirt"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"It was the harpist who rehearsed the waltz.","id":"c8","operands":[{"cat":"instrument","value":"harp"},{"cat":"piece","value":"waltz"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"Sven sat 3 down the row from Idris.","id":"c9","operands":[{"cat":"musician","value":"sven"},{"cat":"musician","value":"idris"}],"params":{"delta":3,"dir":"greater","numericCat":"seat"},"renderHint":"numDiff","type":"numDiff"},{"clueText":"Of Greta and Pablo, one tuned the oboe and the other tuned the trumpet.","id":"c10","operands":[{"cat":"musician","value":"greta"},{"cat":"musician","value":"pablo"},{"cat":"instrument","value":"oboe"},{"cat":"instrument","value":"trumpet"}],"params":{},"renderHint":"oneEachOf","type":"oneEachOf"},{"clueText":"For Greta it was Skirt or Gown - not both.","id":"c11","operands":[{"cat":"musician","value":"greta"},{"cat":"outfit","value":"womanskirt"},{"cat":"outfit","value":"womandress"}],"params":{},"renderHint":"oneOf","type":"oneOf"},{"clueText":"Chair 6 was