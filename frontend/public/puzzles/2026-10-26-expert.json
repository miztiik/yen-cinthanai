":"refill","value":"refill7"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"Lila served 2 refills more than Mei.","id":"c3","operands":[{"cat":"server","value":"lila"},{"cat":"server","value":"mei"}],"params":{"delta":2,"dir":"greater","numericCat":"refill"},"renderHint":"numDiff","type":"numDiff"},{"clueText":"For Lila the board read Veranda or Low table - just one was true.","id":"c4","operands":[{"cat":"server","value":"lila"},{"cat":"table","value":"veranda"},{"cat":"table","value":"lowtable"}],"params":{},"renderHint":"oneOf","type":"oneOf"},{"clueText":"It was the warm-milk server who poured 3 refills.","id":"c5","operands":[{"cat":"brew","value":"milk"},{"cat":"refill","value":"refill3"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"Of Keiko and Tariq, one waited on the tatami mat and the other waited on the window seat.","id":"c6","operands":[{"cat":"server","value":"keiko"},{"cat":"server","value":"tariq"},{"cat":"table","value":"tatamimat"},{"cat":"table","value":"windowseat"}],"params":{},"renderHint":"oneEachOf","type":"oneEachOf"},{"clueText":"It was Arjun who poured 13 refills.","id":"c7","operands":[{"cat":"server","value":"arjun"},{"cat":"refill","value":"refill13"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"Mei served at least 9 refills.","id":"c8","operands":[{"cat":"server","value":"mei"}],"params":{"bound":9,"dir":"atleast","numericCat":"refill"},"renderHint":"threshold","type":"threshold"},{"clueText":"the green-tea server was not the one who waited on the low table.","id":"c9","operands":[{"cat":"brew","value":"tea"},{"cat":"table","value":"lowtable"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"the popsicle server was not the one who waited on the low table.","id":"c10","operands":[{"cat":"sweet","value":"popsicle"},{"cat":"table","value":"lowtable"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"The one who brought out the cupcake was not the barley-water server.","id":"c11","opera