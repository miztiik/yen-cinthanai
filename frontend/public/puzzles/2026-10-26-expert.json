 was down to Cookie or Popsicle, and only one was right.","id":"c20","operands":[{"cat":"server","value":"lila"},{"cat":"sweet","value":"cookie"},{"cat":"sweet","value":"popsicle"}],"params":{},"renderHint":"oneOf","type":"oneOf"},{"clueText":"Omar was down to Coffee or Green tea, and only one was right.","id":"c21","operands":[{"cat":"server","value":"omar"},{"cat":"brew","value":"coffee"},{"cat":"brew","value":"tea"}],"params":{},"renderHint":"oneOf","type":"oneOf"}],"entities":["e0","e1","e2","e3","e4","e5"],"hintTrace":[{"forces":{"cat":"brew","entity":"e1","value":"juice"},"fromClues":["c12"]},{"forces":{"cat":"brew","entity":"e2","value":"tea"},"fromClues":["c9","c16","c21"]},{"forces":{"cat":"brew","entity":"e0","value":"water"},"fromClues":["c11","c13"]},{"forces":{"cat":"brew","entity":"e4","value":"soda"},"fromClues":["c15"]},{"forces":{"cat":"brew","entity":"e5","value":"coffee"},"fromClues":["c21"]},{"forces":{"cat":"brew","entity":"e3","value":"milk"},"fromClues":["c5"]},{"forces":{"cat":"refill","entity":"e3","value":"refill3"},"fromClues":["c5"]},{"forces":{"cat":"refill","entity":"e0","value":"refill13"},"fromClues":["c7"]},{"forces":{"cat":"refill","entity":"e1","value":"refill9"},"fromClues":["c15","c18"]},{"forces":{"cat":"refill","entity":"e4","value":"refill7"},"fromClues":["c2"]},{"forces":{"cat":"refill","entity":"e2","value":"refill11"},"fromClues":["c1"]},{"forces":{"cat":"refill","entity":"e5","value":"refill5"},"fromClues":["c1"]},{"forces":{"cat":"sweet","entity":"e5","value":"popsicle"},"fromClues":["c10","c14","c17","c20"]},{"forces":{"cat":"sweet","entity":"e4","value":"icecream"},"fromClues":["c17","c19"]},{"forces":{"cat":"sweet","entity":"e3","value":"donut"},"fromClues":["c14"]},{"forces":{"cat":"sweet","entity":"e2","value":"cookie"},"fromClues":["c20"]},{"forces":{"cat":"sweet","entity":"e1","value":"cupcake"},"fromClues":["c1","c11"]},{"forces":{"cat":"sweet","entity":"e0","value":"gingerbread"},"fromClues":["c18"]},{"forces":{"