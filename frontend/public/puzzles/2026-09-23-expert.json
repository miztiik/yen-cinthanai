ank","kind":"nominal","label":"Tank","values":[{"glyph":"","id":"abyss","label":"Deep Abyss","phrase":"tends the Deep Abyss","refPhrase":"one at the Deep Abyss"},{"glyph":"","id":"tidepool","label":"Tide Pool","phrase":"tends the Tide Pool","refPhrase":"one at the Tide Pool"},{"glyph":"","id":"kelp","label":"Kelp Forest","phrase":"tends the Kelp Forest","refPhrase":"one at the Kelp Forest"},{"glyph":"","id":"reef","label":"Coral Reef","phrase":"tends the Coral Reef","refPhrase":"one at the Coral Reef"},{"glyph":"","id":"openocean","label":"Open Ocean","phrase":"tends the Open Ocean","refPhrase":"one at the Open Ocean"},{"glyph":"","id":"mangrove","label":"Mangrove","phrase":"tends the Mangrove","refPhrase":"one at the Mangrove"}]},{"anchor":false,"cardinality":"bijective","glyphPack":"food","id":"treat","kind":"nominal","label":"Treat","values":[{"glyph":"food.chocolate","id":"chocolate","label":"Chocolate","phrase":"handed out the chocolate","refPhrase":"chocolate giver"},{"glyph":"food.popsicle","id":"popsicle","label":"Popsicle","phrase":"handed out the popsicles","refPhrase":"popsicle giver"},{"glyph":"food.cookie","id":"cookie","label":"Cookies","phrase":"handed out the cookies","refPhrase":"cookie giver"},{"glyph":"food.icecream","id":"icecream","label":"Ice cream","phrase":"handed out the ice cream","refPhrase":"ice-cream giver"},{"glyph":"food.donut","id":"donut","label":"Donut","phrase":"handed out the donuts","refPhrase":"donut giver"},{"glyph":"food.cupcake","id":"cupcake","label":"Cupcake","phrase":"handed out the cupcakes","refPhrase":"cupcake giver"}]}],"n":5},"constraints":[{"clueText":"The one who took the 2nd feeding was the one with the shark.","id":"c1","operands":[{"cat":"creature","value":"shark"},{"cat":"feeding","value":"feed2"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"Kai was down to Shark or Fish, and took just one.","id":"c2","operands":[{"cat":"keeper","value":"kai"},{"cat":"creature","value":"shark"},{"cat":"creature","value":"fish"}],"params":{},"renderHint":"oneOf","type":"oneOf"},{"clueText":"For Mina it came to Donut or Ice cream - only one, in the end.","id":"c3","operands":[{"cat":"keeper","value":"mina"},{"cat":"treat","value":"donut"},{"cat":"treat","value":"icecream"}],"params":{},"renderHint":"oneOf","type":"oneOf"},{"clueText":"If Tom looks after the penguin, then Rosa was not the one who handed out the cookies.","id":"c4","operands":[{"cat":"keeper","value":"tom"},{"cat":"creature","value":"penguin"},{"cat":"keeper","value":"rosa"},{"cat":"treat","value":"cookie"}],"params":{},"renderHint":"ifThen","type":"ifThen"},{"clueText":"the one with the shrimp took the 3rd feeding.","id":"c5","operands":[{"cat":"creature","value":"shrimp"},{"cat":"feeding","value":"feed3"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"the one with the penguin handed out the popsicles.","id":"c6","operands":[{"cat":"creature","value":"penguin"},{"cat":"treat","value":"popsicle"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"Gus's feeding came 1 rounds after Rosa's.","id":"c7","operands":[{"cat":"keeper","value":"gus"},{"cat":"keeper","value":"rosa"}],"params":{"delta":1,"dir":"greater","numericCat":"feeding"},"renderHint":"numDiff","type":"numDiff"},{"clueText":"Layla was down to Chocolate or Popsicle, and took just one.","id":"c8","operands":[{"cat":"keeper","value":"layla"},{"cat":"treat","value":"chocolate"},{"cat":"treat","value":"popsicle"}],"params":{},"renderHint":"oneOf","type":"oneOf"},{"clueText":"the one with the shark handed out the ice cream.","id":"c9","operands":[{"cat":"creature","value":"shark"},{"cat":"treat","value":"icecream"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"Layla was down to Turtle or Shark, and took just one.","id":"c10","operands":[{"cat":"keeper","value":"layla"},{"cat":"creature","value":"turtle"},{"cat":"creature","value":"shark"}],"params":{},"renderHint":"oneOf","type":"oneOf"},{"clueText":"Layla's feeding came 3 rounds after Kai's.","id":"c11","operands":[{"cat":"keeper","value":"layla"},{"cat":"keeper","value":"kai"}],"params":{"delta":3,"dir":"greater","numericCat":"feeding"},"renderHint":"numDiff","type":"numDiff"},{"clueText":"It was the one with the fish who tends the Open Ocean.","id":"c12","operands":[{"cat":"creature","value":"fish"},{"cat":"tank","value":"openocean"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"Of Mina and Layla, one tends the Tide Pool and the other tends the Mangrove.","id":"c13","operands":[{"cat":"keeper","value":"mina"},{"cat":"keeper","value":"layla"},{"cat":"tank","value":"tidepool"},{"cat":"tank","value":"mangrove"}],"params":{},"renderHint":"oneEachOf","type":"oneEachOf"},{"clueText":"It was 1st who tends the Kelp Forest.","id":"c14","operands":[{"cat":"feeding","value":"feed1"},{"cat":"tank","value":"kelp"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"Of Layla and Rosa, one tends the Mangrove and the other tends the Coral Reef.","id":"c15","operands":[{"cat":"keeper","value":"layla"},{"cat":"keeper","value":"rosa"},{"cat":"tank","value":"mangrove"},{"cat":"tank","value":"reef"}],"params":{},"renderHint":"oneEachOf","type":"oneEachOf"}],"entities":["e0","e1","e2","e3","e4","e5"],"hintTrace":[{"forces":{"cat":"creature","entity":"e2","value":"crab"},"fromClues":["c1"]},{"forces":{"cat":"creature","entity":"e0","value":"fish"},"fromClues":["c2","c12"]},{"forces":{"cat":"creature","entity":"e1","value":"penguin"},"fromClues":["c4","c6"]},{"forces":{"cat":"creature","entity":"e4","value":"shark"},"fromClues":["c1","c2","c9","c10"]},{"forces":{"cat":"creature","entity":"e5","value":"shrimp"},"fromClues":["c5"]},{"forces":{"cat":"creature","entity":"e3","value":"turtle"},"fromClues":["c10"]},{"forces":{"cat":"feeding","entity":"e0","value":"feed4"},"fromClues":["c1"]},{"forces":{"cat":"feeding","entity":"e5","value":"feed3"},"fromClues":["c5"]},{"forces":{"cat":"feeding","entity":"e4","value":"feed2"},"fromClues":["c1"]},{"forces":{