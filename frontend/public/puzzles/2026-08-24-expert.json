ase":"one with the binoculars"},{"glyph":"","id":"dobsonian","label":"Dobsonian","phrase":"set up the Dobsonian","refPhrase":"Dobsonian owner"},{"glyph":"","id":"camera","label":"Camera","phrase":"mounted the camera","refPhrase":"one with the camera"},{"glyph":"","id":"reflector","label":"Reflector","phrase":"set up the reflector","refPhrase":"reflector owner"},{"glyph":"","id":"spectroscope","label":"Spectroscope","phrase":"fitted the spectroscope","refPhrase":"one with the spectroscope"},{"glyph":"","id":"refractor","label":"Refractor","phrase":"set up the refractor","refPhrase":"refractor owner"}]},{"anchor":false,"cardinality":"bijective","glyphPack":"drinks","id":"drink","kind":"nominal","label":"Drink","values":[{"glyph":"drinks.soda","id":"soda","label":"Soda","phrase":"cracked open the soda","refPhrase":"soda drinker"},{"glyph":"drinks.juice","id":"juice","label":"Juice","phrase":"poured the juice","refPhrase":"juice drinker"},{"glyph":"drinks.coffee","id":"coffee","label":"Coffee","phrase":"sipped the coffee","refPhrase":"coffee drinker"},{"glyph":"drinks.tea","id":"tea","label":"Tea","phrase":"brewed the tea","refPhrase":"tea drinker"},{"glyph":"drinks.milk","id":"milk","label":"Warm milk","phrase":"warmed the milk","refPhrase":"milk drinker"},{"glyph":"drinks.water","id":"water","label":"Water","phrase":"sipped the water","refPhrase":"water drinker"}]}],"n":5},"constraints":[{"clueText":"It was not the one with the camera who cracked open the soda.","id":"c1","operands":[{"cat":"instrument","value":"camera"},{"cat":"drink","value":"soda"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"For Beatriz it was Soda or Warm milk - only one.","id":"c2","operands":[{"cat":"astronomer","value":"beatriz"},{"cat":"drink","value":"soda"},{"cat":"drink","value":"milk"}],"params":{},"renderHint":"oneOf","type":"oneOf"},{"clueText":"6 hrs was not the one who set up the reflector.","id":"c3","operands":[{"cat":"vigil","value":"hr6"},{"cat":"instrument","value":"reflector"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"The one who sipped the coffee was 7 hrs.","id":"c4","operands":[{"cat":"vigil","value":"hr7"},{"cat":"drink","value":"coffee"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"It was not 7 hrs who mounted the camera.","id":"c5","operands":[{"cat":"vigil","value":"hr7"},{"cat":"instrument","value":"camera"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"It was Kwame who kept vigil for 2 hours.","id":"c6","operands":[{"cat":"astronomer","value":"kwame"},{"cat":"vigil","value":"hr2"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"It was not the moon watcher who set up the Dobsonian.","id":"c7","operands":[{"cat":"target","value":"moon"},{"cat":"instrument","value":"dobsonian"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"Orla's vigil ran 1 longer than Sanjay's.","id":"c8","operands":[{"cat":"astronomer","value":"orla"},{"cat":"astronomer","value":"sanjay"}],"params":{"delta":1,"dir":"greater","numericCat":"vigil"},"renderHint":"numDiff","type":"numDiff"},{"clueText":"If Kwame sketched the nebula, then Milo was not the one who brewed the tea.","id":"c9","operands":[{"cat":"astronomer","value":"kwame"},{"cat":"target","value":"nebula"},{"cat":"astronomer","value":"milo"},{"cat":"drink","value":"tea"}],"params":{},"renderHint":"ifThen","type":"ifThen"},{"clueText":"Kwame settled on either Warm milk or Soda, not both.","id":"c10","operands":[{"cat":"astronomer","value":"kwame"},{"cat":"drink","value":"milk"},{"cat":"drink","value":"soda"}],"params":{},"renderHint":"oneOf","type":"oneOf"},{"clueText":"It was the comet chaser who fitted the spectroscope.","id":"c11","operands":[{"cat":"target","value":"comet"},{"cat":"instrument","value":"spectroscope"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"The one who kept vigil for 7 hours was the Saturn watcher.","id":"c12","operands":[{"cat":"target","value":"saturn"},{"cat":"vigil","value":"hr7"}],"param