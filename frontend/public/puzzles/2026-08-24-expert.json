mClues":["c11","c19"]},{"forces":{"cat":"instrument","entity":"e1","value":"refractor"},"fromClues":["c15"]},{"forces":{"cat":"drink","entity":"e3","value":"soda"},"fromClues":["c1","c2","c10"]},{"forces":{"cat":"drink","entity":"e1","value":"juice"},"fromClues":["c20"]},{"forces":{"cat":"drink","entity":"e5","value":"coffee"},"fromClues":["c4","c22"]},{"forces":{"cat":"drink","entity":"e2","value":"tea"},"fromClues":["c9"]},{"forces":{"cat":"drink","entity":"e0","value":"milk"},"fromClues":["c2","c10"]},{"forces":{"cat":"drink","entity":"e4","value":"water"},"fromClues":["c22"]}],"puzzleId":"2026-08-24","scenarioId":"observatory-night","schemaVersion":2,"shapeId":"grid","solution":{"e0":{"astronomer":"kwame","drink":"milk","instrument":"camera","target":"nebula","vigil":"hr2"},"e1":{"astronomer":"milo","drink":"juice","instrument":"refractor","target":"moon","vigil":"hr3"},"e2":{"astronomer":"sanjay","drink":"tea","instrument":"spectroscope","target":"comet","vigil":"hr6"},"e3":{"astronomer":"beatriz","drink":"soda","instrument":"reflector","target":"cluster","vigil":"hr5"},"e4":{"astronomer":"inga","drink":"water","instrument":"dobsonian","target":"mars","vigil":"hr4"},"e5":{"astronomer":"orla","drink":"coffee","instrument":"binoculars","target":"saturn","vigil":"hr7"}},"story":"It is a clear, dark night up on the ridge, and six stargazers have carried their gear to the old observatory lawn, where old Halvorsen, who minds the dome, is trying to remember who set up where before the flat torch battery muddled the log. Each stargazer has a different target, vigil, instrument and drink. Using the clues, match every stargazer to their target, vigil, instrument and drink.","subjectNoun":"stargazer","templateRev":1,"tier":"expert","variant":1}
