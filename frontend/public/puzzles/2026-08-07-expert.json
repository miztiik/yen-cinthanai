alue":"rhian"},{"cat":"quarry","value":"squirrel"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"It was not the squirrel chaser who flew 6 flights.","id":"c3","operands":[{"cat":"quarry","value":"squirrel"},{"cat":"flight","value":"flight6"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"Of Idris and Rhian, one used the purple hood and the other used the yellow hood.","id":"c4","operands":[{"cat":"falconer","value":"idris"},{"cat":"falconer","value":"rhian"},{"cat":"hood","value":"purple"},{"cat":"hood","value":"yellow"}],"params":{},"renderHint":"oneEachOf","type":"oneEachOf"},{"clueText":"It was not the red-hood falconer who rested the bird on the mews rail.","id":"c5","operands":[{"cat":"hood","value":"red"},{"cat":"perch","value":"mewsrail"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"the mouse chaser used the red hood.","id":"c6","operands":[{"cat":"quarry","value":"mouse"},{"cat":"hood","value":"red"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"6 flights was not the one who rested the bird on the mews rail.","id":"c7","operands":[{"cat":"flight","value":"flight6"},{"cat":"perch","value":"mewsrail"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"The one who flew 10 flights was the rabbit chaser.","id":"c8","operands":[{"cat":"quarry","value":"rabbit"},{"cat":"flight","value":"flight10"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"It was not Rhian who rested the bird on the mews rail.","id":"c9","operands":[{"cat":"falconer","value":"rhian"},{"cat":"perch","value":"mewsrail"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"Elowen put up 4 flights more than Rhian.","id":"c10","operands":[{"cat":"falconer","value":"elowen"},{"cat":"falconer","value":"rhian"}],"params":{"delta":4,"dir":"greater","numericCat":"flight"},"renderHint":"numDiff","type":"numDiff"},{"clueText":"the frog chaser used the purple hood.","id":"c11","operands":[{"cat":"quarry","value":"frog"},{"cat":"hood","v