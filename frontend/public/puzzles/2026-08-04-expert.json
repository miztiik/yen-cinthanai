","value":"blue"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"The one who tied off at the purple buoy was 12 m.","id":"c12","operands":[{"cat":"depth","value":"d12"},{"cat":"buoy","value":"purple"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"10 m was not the one who tied off at the green buoy.","id":"c13","operands":[{"cat":"depth","value":"d10"},{"cat":"buoy","value":"green"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"18 m surveyed the drop-off.","id":"c14","operands":[{"cat":"depth","value":"d18"},{"cat":"zone","value":"dropoff"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"The one who surveyed the cavern was the seahorse counter.","id":"c15","operands":[{"cat":"creature","value":"seahorse"},{"cat":"zone","value":"cavern"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"Of Ravi and Mara, one counted the octopus and the other counted the manta rays.","id":"c16","operands":[{"cat":"diver","value":"ravi"},{"cat":"diver","value":"mara"},{"cat":"creature","value":"octopus"},{"cat":"creature","value":"manta"}],"params":{},"renderHint":"oneEachOf","type":"oneEachOf"},{"clueText":"It was 8 m who tied off at the yellow buoy.","id":"c17","operands":[{"cat":"depth","value":"d8"},{"cat":"buoy","value":"yellow"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"Mara dived no shallower than 15 metres.","id":"c18","operands":[{"cat":"diver","value":"mara"}],"params":{"bound":15,"dir":"atleast","numericCat":"depth"},"renderHint":"threshold","type":"threshold"},{"clueText":"It was not the lagoon diver who tied off at the orange buoy.","id":"c19","operands":[{"cat":"zone","value":"lagoon"},{"cat":"buoy","value":"orange"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"the clownfish counter was not the one who tied off at the blue buoy.","id":"c20","operands":[{"cat":"creature","value":"clownfish"},{"cat":"buoy","value":"blue"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"It was not 15 m who surveyed the shallows.","id":"c21","operands":[{"cat":"depth","value":"d15"},{"cat":"zone","value":"shallows"}],"params":{},"renderHint":"neq","type":"neq"}],"entities":["e0","e1","e2","e3","e4","e5"],"hintTrace":[{"forces":{"cat":"creature","entity":"e4","value":"seahorse"},"fromClues":["c4","c15"]},{"forces":{"cat":"creature","entity":"e1","value":"octopus"},"fromClues":["c16"]},{"forces":{"cat":"creature","entity":"e0","value":"clownfish"},"fromClues":["c20"]},{"forces":{"cat":"creature","entity":"e5","value":"manta"},"fromClues":["c3","c16"]},{"forces":{"cat":"creature","entity":"e3","value":"angelfish"},"fromClues":["c1"]},{"forces":{"cat":"creature","entity":"e2","value":"moray"},"fromClues":["c4"]},{"forces":{"cat":"depth","entity":"e1","value":"d12"},"fromClues":["c8","c12"]},{"forces":{"cat":"depth","entity":"e2","value":"d10"},"fromClues":["c13"]},{"forces":{"cat":"depth","entity":"e4","value":"d8"},"fromClues":["c17"]},{"forces":{"cat":"depth","entity":"e3","value":"d18"},"fromClues":["c14"]},{"forces":{"cat":"depth","entity":"e0","value":"d20"},"fromClues":["c1","c7"]},{"forces":{"cat":"depth","entity":"e5","value":"d15"},"fromClues":["c21"]},{"forces":{"cat":"zone","entity":"e4","value":"cavern"},"fromClues":["c2","c15"]},{"forces":{"cat":"zone","entity":"e5","value":"pinnacle"},"fromClues":["c7"]},{"forces":{"cat":"zone","entity":"e3","value":"dropoff"},"fromClues":["c14"]},{"forces":{"cat":"zone","entity":"e1","value":"shallows"},"fromClues":["c1","c21"]},{"forces":{"cat":"zone","entity":"e2","value":"lagoon"},"fromClues":["c10","c19"]},{"forces":{"cat":"zone","entity":"e0","value":"canyon"},"fromClues":["c2","c11"]},{"forces":{"cat":"buoy","entity":"e1","value":"purple"},"fromClues":["c12"]},{"forces":{"cat":"buoy","entity":"e2","value":"red"},"fromClues":["c1"]},{"forces":{"cat":"buoy","entity":"e3","value":"blue"},"fromClues":["c6","c11","c20"]},{"forces":{"cat":"buoy","entity":"e4","value":"yellow"},"fromClues":["c9","c17"]},{"forces":{"cat":