ue":"yellow"},{"cat":"pair","value":"pair4"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"The one who worked on the clog was not the purple-thread cobbler.","id":"c4","operands":[{"cat":"thread","value":"purple"},{"cat":"shoe","value":"clog"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"Mei was not the one who stitched with the yellow thread.","id":"c5","operands":[{"cat":"cobbler","value":"mei"},{"cat":"thread","value":"yellow"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"It was the green-thread cobbler who gave it new laces.","id":"c6","operands":[{"cat":"thread","value":"green"},{"cat":"fix","value":"newlaces"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"It was 3 pairs who gave it a re-stitch.","id":"c7","operands":[{"cat":"pair","value":"pair3"},{"cat":"fix","value":"restitch"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"Ferdinand was down to Buffed shine or Re-stitch, and only one was right.","id":"c8","operands":[{"cat":"cobbler","value":"ferdinand"},{"cat":"fix","value":"buffedshine"},{"cat":"fix","value":"restitch"}],"params":{},"renderHint":"oneOf","type":"oneOf"},{"clueText":"the loafer job was not the one who gave it a fresh heel.","id":"c9","operands":[{"cat":"shoe","value":"loafer"},{"cat":"fix","value":"freshheel"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"The one who mended 7 pairs was not the purple-thread cobbler.","id":"c10","operands":[{"cat":"thread","value":"purple"},{"cat":"pair","value":"pair7"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"It was 7 pairs who gave it a new sole.","id":"c11","operands":[{"cat":"pair","value":"pair7"},{"cat":"fix","value":"newsole"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"Of Mei and Aiko, one gave it a leather patch and the other gave it new laces.","id":"c12","operands":[{"cat":"cobbler","value":"mei"},{"cat":"cobbler","value":"aiko"},{"cat":"fix","value":"leatherpatch"},{"cat":"fix","value":"newlac