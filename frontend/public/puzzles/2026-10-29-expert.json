 finished 4 scrolls.","id":"c3","operands":[{"cat":"ink","value":"red"},{"cat":"scroll","value":"scroll4"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"Idris finished at least 6 scrolls.","id":"c4","operands":[{"cat":"scribe","value":"idris"}],"params":{"bound":6,"dir":"atleast","numericCat":"scroll"},"renderHint":"threshold","type":"threshold"},{"clueText":"Petra was down to Gothic or Uncial, and only one was right.","id":"c5","operands":[{"cat":"scribe","value":"petra"},{"cat":"script","value":"gothic"},{"cat":"script","value":"uncial"}],"params":{},"renderHint":"oneOf","type":"oneOf"},{"clueText":"the violet-ink scribe practised the cursive hand.","id":"c6","operands":[{"cat":"ink","value":"purple"},{"cat":"script","value":"cursive"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"Of Meilin and Idris, one wrote in the blue ink and the other wrote in the green ink.","id":"c7","operands":[{"cat":"scribe","value":"meilin"},{"cat":"scribe","value":"idris"},{"cat":"ink","value":"blue"},{"cat":"ink","value":"green"}],"params":{},"renderHint":"oneEachOf","type":"oneEachOf"},{"clueText":"The one who finished 5 scrolls was Meilin.","id":"c8","operands":[{"cat":"scribe","value":"meilin"},{"cat":"scroll","value":"scroll5"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"4 scrolls wrote with the fude.","id":"c9","operands":[{"cat":"scroll","value":"scroll4"},{"cat":"brush","value":"fude"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"Petra finished at least 3 scrolls.","id":"c10","operands":[{"cat":"scribe","value":"petra"}],"params":{"bound":3,"dir":"atleast","numericCat":"scroll"},"renderHint":"threshold","type":"threshold"},{"clueText":"the violet-ink scribe finished 2 scrolls.","id":"c11","operands":[{"cat":"ink","value":"purple"},{"cat":"scroll","value":"scroll2"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"It was not 5 scrolls who practised the kufic hand.","id":"c12","operands":[{"cat":"scroll","value":"scroll5"},{"cat":"script","value":"kufic"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"The one who practised the uncial hand was the gold-ink scribe.","id":"c13","operands":[{"cat":"ink","value":"yellow"},{"cat":"script","value":"uncial"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"It was not 3 scrolls who wrote with the steel nib.","id":"c14","operands":[{"cat":"scroll","value":"scroll3"},{"cat":"brush","value":"steelnib"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"Idris was down to Italic or Cursive, and only one was right.","id":"c15","operands":[{"cat":"scribe","value":"idris"},{"cat":"script","value":"italic"},{"cat":"script","value":"cursive"}],"params":{},"renderHint":"oneOf","type":"oneOf"},{"clueText":"For Tobias the ledger read Gold ink or Violet ink - just one was true.","id":"c16","operands":[{"cat":"scribe","value":"tobias"},{"cat":"ink","value":"yellow"},{"cat":"ink","value":"purple"}],"params":{},"renderHint":"oneOf","type":"oneOf"},{"clueText":"Of Jun and Idris, one wrote with the fude and the other wrote with the felt tip.","id":"c17","operands":[{"cat":"scribe","value":"jun"},{"cat":"scribe","value":"idris"},{"cat":"brush","value":"fude"},{"cat":"brush","value":"felttip"}],"params":{},"renderHint":"oneEachOf","type":"oneEachOf"},{"clueText":"It was not the gothic scribe who wrote with the quill.","id":"c18","operands":[{"cat":"script","value":"gothic"},{"cat":"brush","value":"quill"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"Salma finished 1 more scrolls than Tobias did.","id":"c19","operands":[{"cat":"scribe","value":"salma"},{"cat":"scribe","value":"tobias"}],"params":{"delta":1,"dir":"greater","numericCat":"scroll"},"renderHint":"numDiff","type":"numDiff"},{"clueText":"The one who wrote with the bamboo brush was not 5 scrolls.","id":"c20","operands":[{"cat":"scroll","value":"scroll5"},{"cat":"brush","value":"bamboobrush"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"Tobias was not the one who wrote with the steel nib.","id":"c21","operands":[{"cat":"scribe","value":"tobias"},{"cat":"brush","value":"steelnib"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"Meilin was down to Blue ink or Gold ink, and only one was right.","id":"c22","operands":[{"cat":"scribe","value":"meilin"},{"cat":"ink","value":"blue"},{"cat":"ink","value":"yellow"}],"params":{},"renderHint":"oneOf","type":"oneOf"}],"entities":["e0","e1","e2","e3","e4","e5"],"hintTrace":[{"forces":{"cat":"ink","entity":"e2","value":"orange"},"fromClues":["c1"]},{"forces":{"cat":"ink","entity":"e0","value":"blue"},"fromClues":["c7","c22"]},{"forces":{"cat":"ink","entity":"e3","value":"purple"},"fromClues":["c6","c11","c16"]},{"forces":{"cat":"ink","entity":"e1","value":"yellow"},"fromClues":["c13","c16","c22"]},{"forces":{"cat":"ink","entity":"e5","value":"green"},"fromClues":["c7"]},{"forces":{"cat":"ink","entity":"e4","value":"red"},"fromClues":["c3"]},{"forces":{"cat":"scroll","entity":"e4","value":"scroll3"},"fromClues":["c2","c14"]},{"forces":{"cat":"scroll","entity":"e1","value":"scroll1"},"fromClues":["c1"]},{"forces":{"cat":"scroll","entity":"e0","value":"scroll5"},"fromClues":["c8","c12","c20"]},{"forces":{"cat":"scroll","entity":"e2","value":"scroll4"},"fromClues":["c3","c9"]},{"forces":{"cat":"scroll","entity":"e3","value":"scroll2"},"fromClues":["c11"]},{"forces":{"cat":"scroll","entity":"e5","value":"scroll6"},"fromClues":["c1"]},{"forces":{"cat":"script","entity":"e2","value":"kufic"},"fromClues":["c12"]},{"forces":{"cat":"script","entity":"e5","value":"italic"},"fromClues":["c15"]},{"forces":{"cat":"script","entity":"e1","value":"uncial"},"fromClues":["c1","c5","c13"]},{"forces":{"cat":"script","entity":"e4","value":"gothic"},"fromClues":["c5","c18"]},{"forces":{"cat":"script","entity":"e0","value":"sealscript"},"fromClues":["c1"]},{"forces":{"cat":"script","entity":"e3","value":"cursive"},"fromClues":["c6","c15"]},{"forces":{"cat":"brush","entity":"e5","value":"felttip"},"fromClues":["c17"]},{"forces":{"cat":"brush","entity":"e1","value":"quill"},"fromClues":["c18"]},{"forces":{"cat":"brush","entity":"e0","value":"steelnib"},"fromClues":["c14","c21"]},{"forces":{"cat":"brush","entity":"e3","value":"bamboobrush"},"fromClues":["c1","c2","c20"]},{"forces":{"cat":"brush","entity":"e4","value":"reedpen"},"fromClues":["c1"]},{"forces":{"cat":"brush","entity":"e2","value":"fude"},"fromClues":["c9","c17"]}],"puzzleId":"2026-10-29","scenarioId":"calligraphy-hall","schemaVersion":2,"shapeId":"grid","solution":{"e0":{"brush":"steelnib","ink":"blue","scribe":"meilin","script":"sealscript","scroll":"scroll5"},"e1":{"brush":"quill","ink":"yellow","scribe":"tobias","script":"uncial","scroll":"scroll1"},"e2":{"brush":"fude","ink":"orange","scribe":"jun","script":"kufic","scroll":"scroll4"},"e3":{"brush":"bamboobrush","ink":"purple","scribe":"salma","script":"cursive","scroll":"scroll2"},"e4":{"brush":"reedpen","ink":"red","scribe":"petra","script":"gothic","scroll":"scroll3"},"e5":{"brush":"felttip","ink":"green","scribe":"idris","script":"italic","scroll":"scroll6"}},"story":"Quiet settles over the long hall as six scribes bend to their desks, and old Master Wen works out whose sheet was whose after a tipped water dish sent the drying pages sliding, a distant bell the only sound. Each scribe has a different ink, scroll, script and brush. Using the clues, match every scribe to their ink, scroll, script and brush.","subjectNoun":"scribe","templateRev":1,"tier":"expert","variant":1}
