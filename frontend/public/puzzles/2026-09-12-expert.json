:"plumbline"}],"params":{},"renderHint":"oneOf","type":"oneOf"},{"clueText":"The one who worked with the spade was not the Celtic hand.","id":"c4","operands":[{"cat":"era","value":"celtic"},{"cat":"tool","value":"spade"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"Emeka worked layer 2 or deeper.","id":"c5","operands":[{"cat":"digger","value":"emeka"}],"params":{"bound":2,"dir":"atleast","numericCat":"layer"},"renderHint":"threshold","type":"threshold"},{"clueText":"The one who worked with the plumb line was not the Celtic hand.","id":"c6","operands":[{"cat":"era","value":"celtic"},{"cat":"tool","value":"plumbline"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"Odette was down to Plumb line or Brush, and only one was logged.","id":"c7","operands":[{"cat":"digger","value":"odette"},{"cat":"tool","value":"plumbline"},{"cat":"tool","value":"brush"}],"params":{},"renderHint":"oneOf","type":"oneOf"},{"clueText":"It was Layer 4 who worked with the brush.","id":"c8","operands":[{"cat":"layer","value":"ly4"},{"cat":"tool","value":"brush"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"It was the Roman hand who worked with the sieve.","id":"c9","operands":[{"cat":"era","value":"roman"},{"cat":"tool","value":"sieve"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"For Selin the register read Spade or Brush - just one was true.","id":"c10","operands":[{"cat":"digger","value":"selin"},{"cat":"tool","value":"spade"},{"cat":"tool","value":"brush"}],"params":{},"renderHint":"oneOf","type":"oneOf"},{"clueText":"The one who worked layer 3 was the seal finder.","id":"c11","operands":[{"cat":"relic","value":"seal"},{"cat":"layer","value":"ly3"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"Emeka was down to Mosaic or Idol, and only one was logged.","id":"c12","operands":[{"cat":"digger","value":"emeka"},{"cat":"relic","value":"mosaic"},{"cat":"relic","value":"idol"}],"params":{},"renderHint":"oneOf","type":"oneOf"},{"clueText":"