ist"}],"params":{},"renderHint":"oneEachOf","type":"oneEachOf"}],"entities":["e0","e1","e2","e3","e4","e5"],"hintTrace":[{"forces":{"cat":"role","entity":"e4","value":"chemist"},"fromClues":["c8","c19"]},{"forces":{"cat":"role","entity":"e2","value":"scientist"},"fromClues":["c1","c12"]},{"forces":{"cat":"role","entity":"e1","value":"photographer"},"fromClues":["c1"]},{"forces":{"cat":"role","entity":"e5","value":"astronomer"},"fromClues":["c1","c5","c15"]},{"forces":{"cat":"role","entity":"e3","value":"engineer"},"fromClues":["c2","c11"]},{"forces":{"cat":"role","entity":"e0","value":"biologist"},"fromClues":["c19"]},{"forces":{"cat":"sample","entity":"e3","value":"s12"},"fromClues":["c11"]},{"forces":{"cat":"sample","entity":"e2","value":"s18"},"fromClues":["c1"]},{"forces":{"cat":"sample","entity":"e0","value":"s9"},"fromClues":["c4","c8"]},{"forces":{"cat":"sample","entity":"e4","value":"s4"},"fromClues":["c14"]},{"forces":{"cat":"sample","entity":"e1","value":"s6"},"fromClues":["c1"]},{"forces":{"cat":"sample","entity":"e5","value":"s15"},"fromClues":["c17"]},{"forces":{"cat":"instrument","entity":"e4","value":"magnetometer"},"fromClues":["c3"]},{"forces":{"cat":"instrument","entity":"e5","value":"barograph"},"fromClues":["c15"]},{"forces":{"cat":"instrument","entity":"e2","value":"seismograph"},"fromClues":["c6"]},{"forces":{"cat":"instrument","entity":"e3","value":"radiosonde"},"fromClues":["c2","c6"]},{"forces":{"cat":"instrument","entity":"e0","value":"spectrometer"},"fromClues":["c1"]},{"forces":{"cat":"instrument","entity":"e1","value":"anemometer"},"fromClues":["c4"]},{"forces":{"cat":"flask","entity":"e2","value":"soda"},"fromClues":["c9"]},{"forces":{"cat":"flask","entity":"e0","value":"water"},"fromClues":["c7","c18"]},{"forces":{"cat":"flask","entity":"e3","value":"coffee"},"fromClues":["c18"]},{"forces":{"cat":"flask","entity":"e4","value":"tea"},"fromClues":["c3","c9","c14"]},{"forces":{"cat":"flask","entity":"e5","value":"juice"},"fromClues":["c5"