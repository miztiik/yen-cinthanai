Of"},{"clueText":"It was the engineer who minded the radiosonde.","id":"c2","operands":[{"cat":"role","value":"engineer"},{"cat":"instrument","value":"radiosonde"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"The one who kept a flask of spiced tea was the magnetometer keeper.","id":"c3","operands":[{"cat":"instrument","value":"magnetometer"},{"cat":"flask","value":"tea"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"It was not 9 samples who minded the anemometer.","id":"c4","operands":[{"cat":"sample","value":"s9"},{"cat":"instrument","value":"anemometer"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"The one who kept a flask of berry juice was the astronomer.","id":"c5","operands":[{"cat":"role","value":"astronomer"},{"cat":"flask","value":"juice"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"For Bjorn the log read Seismograph or Radiosonde - just one was true.","id":"c6","operands":[{"cat":"researcher","value":"bjorn"},{"cat":"instrument","value":"seismograph"},{"cat":"instrument","value":"radiosonde"}],"params":{},"renderHint":"oneOf","type":"oneOf"},{"clueText":"The one who kept a flask of meltwater was Anouk.","id":"c7","operands":[{"cat":"researcher","value":"anouk"},{"cat":"flask","value":"water"}],"params":{},"renderHint":"eq","type":"eq"},{"clueText":"the chemist was not the one who logged 9 samples.","id":"c8","operands":[{"cat":"role","value":"chemist"},{"cat":"sample","value":"s9"}],"params":{},"renderHint":"neq","type":"neq"},{"clueText":"Bjorn came down to Cream soda or Spiced tea, and only one checked out.","id":"c9","operands":[{"cat":"researcher","value":"bjorn"},{"cat":"flask","value":"soda"},{"cat":"flask","value":"tea"}],"params":{},"renderHint":"oneOf","type":"oneOf"},{"clueText":"Anouk logged 5 more samples than Petra.","id":"c10","operands":[{"cat":"researcher","value":"anouk"},{"cat":"researcher","value":"petra"}],"params":{"delta":5,"dir":"greater","numericCat":"sample"},"renderHint":"numDiff",